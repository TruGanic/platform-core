{
  "name": "platform-core",
  "version": "1.0.0",
  "description": "Core services for the TruGanic platform",
  "private": true,
  "workspaces": [
    "core/*",
    "shared"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace=@core/gateway",
    "dev:security": "npm run dev --workspace=@core/security",
    "dev:registry": "npm run dev --workspace=@core/registry",
    "dev:lifecycle": "npm run dev --workspace=@core/lifecycle",
    "dev:all": "npm-run-all --parallel dev:gateway dev:security dev:registry dev:lifecycle",
    "build:all": "npm run build --workspaces",
    "build:shared": "npm run build --workspace=@shared/types",
    "test:all": "npm run test --workspaces",
    "docker:build": "docker-compose -f infrastructure/docker-compose.yml build",
    "docker:up": "docker-compose -f infrastructure/docker-compose.yml up",
    "docker:down": "docker-compose -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsc-alias": "^1.8.10",
    "@types/opossum": "^8.1.9",
    "nodemon": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
