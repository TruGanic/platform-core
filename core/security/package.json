{
  "name": "@core/security",
  "version": "1.0.0",
  "description": "Security service for DID/VC authentication and authorization",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --delay 1 --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "test": "jest",
    "test:did-resolver": "ts-node -r tsconfig-paths/register src/test/did-resolver.test.ts",
    "test:vc-issuer": "ts-node -r tsconfig-paths/register src/test/vc-issuer.test.ts",
    "test:vc-verifier": "ts-node -r tsconfig-paths/register src/test/vc-verifier.test.ts",
    "test:all": "npm run test:did-resolver && npm run test:vc-issuer"
  },
  "dependencies": {
    "@digitalbazaar/vc": "^4.0.0",
    "@shared/types": "*",
    "@types/elliptic": "^6.4.18",
    "@veramo/core": "^5.0.0",
    "@veramo/did-jwt": "^5.0.0",
    "@veramo/did-resolver": "^5.0.0",
    "cors": "^2.8.5",
    "did-jwt": "^7.0.0",
    "did-resolver": "^4.1.0",
    "dotenv": "^16.6.1",
    "elliptic": "^6.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.8.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "web-did-resolver": "^2.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
